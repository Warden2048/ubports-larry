# Halium / Ubuntu Touch fragment for the LineageOS sm6375 5.4 QGKI kernel.
# Merged on top of vendor/holi-qgki_defconfig.

# Core requirements (systemd, LXC Android container)
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_FHANDLE=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_IPC_NS=y
CONFIG_NET_NS=y
CONFIG_PID_NS=y
CONFIG_USER_NS=y
CONFIG_UTS_NS=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_AUTOFS4_FS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# USB networking for debugging (telnet / ssh over RNDIS)
CONFIG_USB_CONFIGFS_RNDIS=y

# bluebinder + BlueZ profiles
CONFIG_BT_HCIVHCI=y
CONFIG_BT_RFCOMM=y
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_BNEP=y
CONFIG_BT_BNEP_MC_FILTER=y
CONFIG_BT_BNEP_PROTO_FILTER=y
CONFIG_BT_HIDP=y

# AppArmor as the active major LSM (SELinux stays built but inactive)
CONFIG_SECURITY_APPARMOR=y
CONFIG_DEFAULT_SECURITY_APPARMOR=y
CONFIG_LSM="lockdown,yama,loadpin,safesetid,integrity,apparmor,selinux"

# Waydroid
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder,anbox-binder,anbox-hwbinder,anbox-vndbinder"
CONFIG_NETFILTER_XT_TARGET_CHECKSUM=y

# Snaps / squashfs
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_FILE_DIRECT=y
CONFIG_SQUASHFS_DECOMP_MULTI_PERCPU=y
CONFIG_SQUASHFS_XATTR=y
CONFIG_SQUASHFS_LZ4=y
CONFIG_SQUASHFS_LZO=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y

# Docker / LXD helpers
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_NAT=y
CONFIG_IP6_NF_FILTER=y
CONFIG_IP6_NF_NAT=y

# Build-time: no LTO/CFI (keeps memory use sane and modules simple), no debug info
CONFIG_LTO_NONE=y
# CONFIG_LTO_CLANG is not set
# CONFIG_THINLTO is not set
# CONFIG_CFI_CLANG is not set
# CONFIG_DEBUG_INFO is not set

# Newer clang (r510928) flags intentional truncations in vendor techpack code
# CONFIG_CC_WERROR is not set
# Oplus manifest code references __initdata; only caught without LTO
CONFIG_SECTION_MISMATCH_WARN_ONLY=y

# dummy_hcd registers a fake UDC (dummy_udc.0) that usb-moded picked instead of
# the real controller (4e00000.dwc3), so the phone never showed up on USB
# CONFIG_USB_DUMMY_HCD is not set

# Stable kernel release string ("5.4.302-qgki"): no git hash / "-dirty" suffix,
# so kernel modules always match the running kernel
# CONFIG_LOCALVERSION_AUTO is not set

# MTP for Ubuntu Touch mtp-server (/dev/mtp_usb) - kernel-patches/0004
CONFIG_USB_CONFIGFS_F_MTP=y
CONFIG_USB_CONFIGFS_F_PTP=y
